{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

# Front Angular servi par le serveur de dev (`ng serve`, HMR inclus)
(front_dev) {
	reverse_proxy front:4200
}

# Front Angular compilé dans l'image de prod
(front_prod) {
	root * /app/front
	try_files {path} /index.html
	file_server
}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
	}

	root /app/public
	encode zstd br gzip

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Symfony : API, callback OAuth, profiler
	@symfony path /api/* /_profiler* /_wdt* /bundles/*
	handle @symfony {
		@phpRoute not file {path}
		rewrite @phpRoute index.php

		@frontController path index.php
		php @frontController {
			{$FRANKENPHP_SITE_CONFIG}

			worker {
				file ./public/index.php
				{$FRANKENPHP_WORKER_CONFIG}
			}
		}

		file_server {
			hide *.php
		}
	}

	# Tout le reste : application Angular
	handle {
		import front_{$FRONT_MODE:prod}
	}
}
